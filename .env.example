# Postgres connection string. For Neon: Dashboard → your project → Connect →
# copy the "Pooled connection" string (recommended — works well with Render's
# persistent Node process and avoids exhausting Neon's connection limit).
# Must include sslmode=require (Neon requires TLS).
# Example: postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Secret used to sign session cookies (HS256 JWT). Generate a long random
# string for any real deployment — e.g. `openssl rand -hex 32`.
# If unset, a dev-only fallback is used (see src/lib/auth.ts), which is NOT
# safe for production.
SESSION_SECRET=

# Where uploaded files (profile photos, post attachments) are written.
# Defaults to a top-level `uploads/` folder if unset, which is fine for local
# dev but is EPHEMERAL on Render's free tier — files vanish on redeploy or
# restart. To persist them, add a Render "Persistent Disk" (Render dashboard
# → your service → Disks), mount it at e.g. /var/data/uploads, and set:
# UPLOAD_DIR=/var/data/uploads
UPLOAD_DIR=

# No email provider is wired up yet — see src/lib/mailer.ts. Verification and
# password-reset emails are written to the `dev_emails` table and viewable at
# /admin/outbox instead of actually being sent. To go live, add your
# provider's API key here and swap the body of sendEmail() for a real call,
# e.g.:
# RESEND_API_KEY=
